// Zellij config — mirrors WezTerm / tmux keybindings
// Leader equivalent: Ctrl+a (enters Pane mode as dispatcher)

// ─── Behaviour ───────────────────────────────────────────────────────────────

simplified_ui false
pane_frames false
default_shell "zsh"
mouse_mode true
copy_on_select true
scroll_buffer_size 10000
default_layout "compact"

// ─── Theme ───────────────────────────────────────────────────────────────────

theme "kanagawa-dragon"

themes {
    kanagawa-dragon {
        fg      "#c5c9c5"
        bg      "#181616"
        black   "#0d0c0c"
        red     "#c4746e"
        green   "#8a9a7b"
        yellow  "#c4b28a"
        blue    "#8ba4b0"
        magenta "#a292a3"
        cyan    "#8ea4a2"
        white   "#c8c093"
        orange  "#b6927b"
    }
}

// ─── Keybindings ─────────────────────────────────────────────────────────────
// Strategy: Ctrl+a enters Pane mode (acts as the leader key dispatcher).
// Each sub-mode returns to Normal on Escape, Enter, or Ctrl+a.

keybinds clear-defaults=true {

    // ── Normal mode ──────────────────────────────────────────────────────────
    normal {
        // Ctrl+a is the leader — drops into pane mode as dispatcher
        bind "Ctrl a" { SwitchToMode "Pane"; }

    }

    // ── Pane mode (leader dispatcher) ────────────────────────────────────────
    // Mirrors WezTerm LEADER bindings
    pane {
        bind "Esc" { SwitchToMode "Normal"; }
        // Press Ctrl+a again to pass it through to the running program
        bind "Ctrl a" { Write 1; SwitchToMode "Normal"; }

        // Splits — LEADER+\ horizontal, LEADER+- vertical
        bind "\\" { NewPane "Right"; SwitchToMode "Normal"; }
        bind "-"  { NewPane "Down";  SwitchToMode "Normal"; }

        // Zoom — LEADER+z
        bind "z" { ToggleFocusFullscreen; SwitchToMode "Normal"; }

        // Pane navigation — LEADER+h/j/k/l (mirrors tmux)
        bind "h" "Left"  { MoveFocus "Left";  SwitchToMode "Normal"; }
        bind "j" "Down"  { MoveFocus "Down";  SwitchToMode "Normal"; }
        bind "k" "Up"    { MoveFocus "Up";    SwitchToMode "Normal"; }
        bind "l" "Right" { MoveFocus "Right"; SwitchToMode "Normal"; }

        // Close pane — LEADER+w (mirrors WezTerm CMD+w)
        bind "w" { CloseFocus; SwitchToMode "Normal"; }

        // Sub-modes — LEADER+r resize, LEADER+m move, LEADER+y scroll/copy
        bind "r" { SwitchToMode "Resize"; }
        bind "m" { SwitchToMode "Move"; }
        bind "v" { SwitchToMode "Scroll"; }

        // Tab / window — LEADER+t new tab, LEADER+tab list
        bind "t" { NewTab;                SwitchToMode "Normal"; }
        bind "Tab" { SwitchToMode "Tab"; }

        // Rename tab — LEADER+,
        bind "," { SwitchToMode "RenameTab"; TabNameInput 0; }

        // Session — LEADER+s switch, LEADER+d detach
        bind "s" { SwitchToMode "Session"; }
        bind "d" { Detach; }

        // Help overlay
        bind "?" { LaunchOrFocusPlugin "session-manager" {
            floating true
        }; SwitchToMode "Normal"; }
    }

    // ── Tab mode ─────────────────────────────────────────────────────────────
    tab {
        bind "Esc" "Enter" "Ctrl a" { SwitchToMode "Normal"; }

        bind "n" "t" { NewTab;            SwitchToMode "Normal"; }
        bind "w"     { CloseTab;          SwitchToMode "Normal"; }
        bind ","     { SwitchToMode "RenameTab"; TabNameInput 0; }

        // Tab navigation — h/l and arrows
        bind "h" "Left"  { GoToPreviousTab; }
        bind "l" "Right" { GoToNextTab;     }

        // Jump to tab by number (1-9)
        bind "1" { GoToTab 1; SwitchToMode "Normal"; }
        bind "2" { GoToTab 2; SwitchToMode "Normal"; }
        bind "3" { GoToTab 3; SwitchToMode "Normal"; }
        bind "4" { GoToTab 4; SwitchToMode "Normal"; }
        bind "5" { GoToTab 5; SwitchToMode "Normal"; }
        bind "6" { GoToTab 6; SwitchToMode "Normal"; }
        bind "7" { GoToTab 7; SwitchToMode "Normal"; }
        bind "8" { GoToTab 8; SwitchToMode "Normal"; }
        bind "9" { GoToTab 9; SwitchToMode "Normal"; }
    }

    // ── Rename tab ───────────────────────────────────────────────────────────
    renamepane {
        bind "Esc" { UndoRenamePane; SwitchToMode "Normal"; }
        bind "Enter"  { SwitchToMode "Normal"; }
    }

    renametab {
        bind "Esc" { UndoRenameTab; SwitchToMode "Normal"; }
        bind "Enter"  { SwitchToMode "Normal"; }
    }

    // ── Resize mode — LEADER+r ───────────────────────────────────────────────
    // Mirrors tmux: H/J/K/L and arrow keys; stays in resize until Escape
    resize {
        bind "Esc" "Enter" "Ctrl a" { SwitchToMode "Normal"; }

        bind "h" "Left"  { Resize "Increase Left"; }
        bind "j" "Down"  { Resize "Increase Down"; }
        bind "k" "Up"    { Resize "Increase Up"; }
        bind "l" "Right" { Resize "Increase Right"; }
        bind "H" { Resize "Decrease Left"; }
        bind "J" { Resize "Decrease Down"; }
        bind "K" { Resize "Decrease Up"; }
        bind "L" { Resize "Decrease Right"; }
        bind "=" "+" { Resize "Increase"; }
        bind "-"      { Resize "Decrease"; }
    }

    // ── Move mode — LEADER+m ─────────────────────────────────────────────────
    move {
        bind "Esc" "Enter" "Ctrl a" { SwitchToMode "Normal"; }

        bind "h" "Left"  { MovePane "Left"; }
        bind "j" "Down"  { MovePane "Down"; }
        bind "k" "Up"    { MovePane "Up"; }
        bind "l" "Right" { MovePane "Right"; }
        bind "n" "Tab"   { MovePane; }
    }

    // ── Scroll / copy mode — LEADER+v ────────────────────────────────────────
    // Mirrors WezTerm LEADER+v → ActivateCopyMode
    scroll {
        bind "Esc" "Ctrl a" { SwitchToMode "Normal"; }
        bind "Enter"           { SwitchToMode "Normal"; }
        bind "e" { EditScrollback; SwitchToMode "Normal"; }

        // Vim-style scrolling
        bind "j" "Down"    { ScrollDown; }
        bind "k" "Up"      { ScrollUp; }
        bind "Ctrl d" "d"  { HalfPageScrollDown; }
        bind "Ctrl u" "u"  { HalfPageScrollUp; }
        bind "Ctrl f"      { PageScrollDown; }
        bind "Ctrl b"      { PageScrollUp; }
        bind "g"           { ScrollToTop; }
        bind "G"           { ScrollToBottom; }

        // Search — mirrors WezTerm CMD+/
        bind "/" { SwitchToMode "Search"; }

        // Copy selection
        bind "y" { Copy; }
    }

    // ── Search mode ───────────────────────────────────────────────────────────
    search {
        bind "Esc" "Ctrl a" { SwitchToMode "Normal"; }
        bind "Enter"           { SwitchToMode "Scroll"; }

        bind "j" "Down" "n"  { Search "down"; }
        bind "k" "Up"   "N"  { Search "up"; }
        bind "c"             { SearchToggleOption "CaseSensitivity"; }
        bind "w"             { SearchToggleOption "WholeWord"; }
        bind "o"             { SearchToggleOption "Wrap"; }
    }

    // ── Session mode — LEADER+s ───────────────────────────────────────────────
    session {
        bind "Esc" "Enter" "Ctrl a" { SwitchToMode "Normal"; }
        bind "d" { Detach; }
        bind "s" { LaunchOrFocusPlugin "session-manager" {
            floating true
            move_to_focused_tab true
        }; SwitchToMode "Normal"; }
        bind "w" { LaunchOrFocusPlugin "zellij:strider" {
            floating true
        }; SwitchToMode "Normal"; }
    }

    // ── Locked mode (pass-through everything) ────────────────────────────────
    locked {
        bind "Ctrl a" { SwitchToMode "Normal"; }
    }
}

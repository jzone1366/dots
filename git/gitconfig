[core]
  editor = nvim
  pager = delta

[delta]
  navigate = true
  side-by-side = true
  line-numbers = true

[merge]
  conflictstyle = diff3

[diff]
  colorMoved = default

[pull]
  rebase = true

[push]
  autoSetupRemote = true

[init]
  defaultBranch = main

[branch]
  sort = -committerdate

[rerere]
  enabled = true

# Catppuccin Latte palette. Colors only; themes/layout.tmux uses them.
# Upstream: https://catppuccin.com/palette
# WARNING: hex colors can't contain capital letters

set -g @thm_bg        "#eff1f5"   # Base
set -g @thm_bg_gutter "#dce0e8"   # Crust
set -g @thm_fg        "#4c4f69"   # Text
set -g @thm_cyan      "#209fb5"   # Sapphire
set -g @thm_gray      "#8c8fa1"   # Overlay1
set -g @thm_magenta   "#7287fd"   # Lavender
set -g @thm_red       "#d20f39"   # Red
set -g @thm_green     "#40a02b"   # Green
set -g @thm_yellow    "#df8e1d"   # Yellow
set -g @thm_blue      "#1e66f5"   # Blue
set -g @thm_orange    "#fe640b"   # Peach
set -g @thm_hl_med    "#ccd0da"   # Surface0

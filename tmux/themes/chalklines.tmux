# Chalklines Dark palette. Colors only; themes/layout.tmux uses them.
# Upstream: https://github.com/jzone1366/chalklines.nvim
# WARNING: hex colors can't contain capital letters

set -g @thm_bg        "#191919"   # bg
set -g @thm_bg_gutter "#242424"   # bg gutter
set -g @thm_fg        "#c1c7d6"   # fg
set -g @thm_cyan      "#6cbfb5"   # cyan
set -g @thm_gray      "#727a8c"   # gray
set -g @thm_magenta   "#ba76e7"   # magenta
set -g @thm_red       "#ff355b"   # red
set -g @thm_green     "#b7e876"   # green
set -g @thm_yellow    "#ffc251"   # yellow
set -g @thm_blue      "#76d5ff"   # blue
set -g @thm_orange    "#f34b00"   # orange
set -g @thm_hl_med    "#333333"   # highlight

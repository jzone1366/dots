# Kanagawa Dragon palette. Colors only; themes/layout.tmux uses them.
# WARNING: hex colors can't contain capital letters

set -g @thm_bg        "#181616"   # DragonBlack3
set -g @thm_bg_gutter "#282727"   # DragonBlack4
set -g @thm_fg        "#c5c9c5"   # DragonWhite
set -g @thm_cyan      "#8ea4a2"   # DragonAqua
set -g @thm_gray      "#7a8382"   # DragonGray3
set -g @thm_magenta   "#a292a3"   # DragonPink
set -g @thm_red       "#c4746e"   # DragonRed
set -g @thm_green     "#87a987"   # DragonGreen
set -g @thm_yellow    "#c4b28a"   # DragonYellow
set -g @thm_blue      "#8ba4b0"   # DragonBlue2
set -g @thm_orange    "#d98d7b"   # DragonOrange2
set -g @thm_hl_med    "#1d1c19"   # DragonBlack2

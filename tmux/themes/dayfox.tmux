# Nightfox Dayfox palette. Colors only; themes/layout.tmux uses them.
# Upstream: https://github.com/EdenEast/nightfox.nvim
# WARNING: hex colors can't contain capital letters

set -g @thm_bg        "#f6f2ee"   # bg1
set -g @thm_bg_gutter "#dbd1dd"   # bg2
set -g @thm_fg        "#3d2b5a"   # fg1
set -g @thm_cyan      "#287980"   # cyan
set -g @thm_gray      "#837a72"   # comment
set -g @thm_magenta   "#6e33ce"   # magenta
set -g @thm_red       "#a5222f"   # red
set -g @thm_green     "#396847"   # green
set -g @thm_yellow    "#ac5402"   # yellow
set -g @thm_blue      "#2848a9"   # blue
set -g @thm_orange    "#955f61"   # orange
set -g @thm_hl_med    "#e4dcd4"   # bg0

# Rosé Pine palette. Colors only; themes/layout.tmux uses them.
# Upstream: https://rosepinetheme.com/palette (no green; pine/foam stand in)
# WARNING: hex colors can't contain capital letters

set -g @thm_bg        "#191724"   # base
set -g @thm_bg_gutter "#26233a"   # overlay
set -g @thm_fg        "#e0def4"   # text
set -g @thm_cyan      "#9ccfd8"   # foam
set -g @thm_gray      "#6e6a86"   # muted
set -g @thm_magenta   "#c4a7e7"   # iris
set -g @thm_red       "#eb6f92"   # love
set -g @thm_green     "#31748f"   # pine
set -g @thm_yellow    "#f6c177"   # gold
set -g @thm_blue      "#9ccfd8"   # foam
set -g @thm_orange    "#ebbcba"   # rose
set -g @thm_hl_med    "#1f1d2e"   # surface

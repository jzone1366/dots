# Catppuccin Mocha palette. Colors only; themes/layout.tmux uses them.
# Upstream: https://catppuccin.com/palette
# WARNING: hex colors can't contain capital letters

set -g @thm_bg        "#1e1e2e"   # Base
set -g @thm_bg_gutter "#11111b"   # Crust
set -g @thm_fg        "#cdd6f4"   # Text
set -g @thm_cyan      "#74c7ec"   # Sapphire
set -g @thm_gray      "#7f849c"   # Overlay1
set -g @thm_magenta   "#b4befe"   # Lavender
set -g @thm_red       "#f38ba8"   # Red
set -g @thm_green     "#a6e3a1"   # Green
set -g @thm_yellow    "#f9e2af"   # Yellow
set -g @thm_blue      "#89b4fa"   # Blue
set -g @thm_orange    "#fab387"   # Peach
set -g @thm_hl_med    "#313244"   # Surface0

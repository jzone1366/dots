# Rosé Pine Dawn palette. Colors only; themes/layout.tmux uses them.
# Upstream: https://rosepinetheme.com/palette (no green; pine/foam stand in)
# WARNING: hex colors can't contain capital letters

set -g @thm_bg        "#faf4ed"   # base
set -g @thm_bg_gutter "#f2e9e1"   # overlay
set -g @thm_fg        "#575279"   # text
set -g @thm_cyan      "#56949f"   # foam
set -g @thm_gray      "#9893a5"   # muted
set -g @thm_magenta   "#907aa9"   # iris
set -g @thm_red       "#b4637a"   # love
set -g @thm_green     "#286983"   # pine
set -g @thm_yellow    "#ea9d34"   # gold
set -g @thm_blue      "#56949f"   # foam
set -g @thm_orange    "#d7827e"   # rose
set -g @thm_hl_med    "#fffaf3"   # surface

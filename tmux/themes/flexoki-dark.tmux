# Flexoki Dark palette. Colors only; themes/layout.tmux uses them.
# Upstream: https://stephango.com/flexoki (dark uses the 400 accents)
# WARNING: hex colors can't contain capital letters

set -g @thm_bg        "#100f0f"   # black
set -g @thm_bg_gutter "#282726"   # base-900 (ui)
set -g @thm_fg        "#cecdc3"   # base-200 (tx)
set -g @thm_cyan      "#3aa99f"   # cyan-400
set -g @thm_gray      "#878580"   # base-500 (tx-2)
set -g @thm_magenta   "#ce5d97"   # magenta-400
set -g @thm_red       "#d14d41"   # red-400
set -g @thm_green     "#879a39"   # green-400
set -g @thm_yellow    "#d0a215"   # yellow-400
set -g @thm_blue      "#4385be"   # blue-400
set -g @thm_orange    "#da702c"   # orange-400
set -g @thm_hl_med    "#1c1b1a"   # base-950 (bg-2)

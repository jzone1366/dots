# Tokyo Night (night) palette. Colors only; themes/layout.tmux uses them.
# Upstream: https://github.com/folke/tokyonight.nvim
# WARNING: hex colors can't contain capital letters

set -g @thm_bg        "#1a1b26"   # bg
set -g @thm_bg_gutter "#292e42"   # bg_highlight
set -g @thm_fg        "#c0caf5"   # fg
set -g @thm_cyan      "#7dcfff"   # cyan
set -g @thm_gray      "#737aa2"   # dark5
set -g @thm_magenta   "#bb9af7"   # magenta
set -g @thm_red       "#f7768e"   # red
set -g @thm_green     "#9ece6a"   # green
set -g @thm_yellow    "#e0af68"   # yellow
set -g @thm_blue      "#7aa2f7"   # blue
set -g @thm_orange    "#ff9e64"   # orange
set -g @thm_hl_med    "#1f2335"   # bg_dark (storm)

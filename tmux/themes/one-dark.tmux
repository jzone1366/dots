# One Dark palette. Colors only; themes/layout.tmux uses them.
# Upstream: https://github.com/joshdick/onedark.vim
# WARNING: hex colors can't contain capital letters

set -g @thm_bg        "#282c34"   # black
set -g @thm_bg_gutter "#3e4452"   # visual grey
set -g @thm_fg        "#abb2bf"   # white
set -g @thm_cyan      "#56b6c2"   # cyan
set -g @thm_gray      "#5c6370"   # comment grey
set -g @thm_magenta   "#c678dd"   # magenta
set -g @thm_red       "#e06c75"   # red
set -g @thm_green     "#98c379"   # green
set -g @thm_yellow    "#e5c07b"   # yellow
set -g @thm_blue      "#61afef"   # blue
set -g @thm_orange    "#d19a66"   # dark yellow
set -g @thm_hl_med    "#2c323c"   # cursor grey

# Tomorrow Night Bright palette. Colors only; themes/layout.tmux uses them.
# Upstream: https://github.com/chriskempson/tomorrow-theme
# WARNING: hex colors can't contain capital letters

set -g @thm_bg        "#000000"   # Background
set -g @thm_bg_gutter "#2a2a2a"   # Current Line
set -g @thm_fg        "#eaeaea"   # Foreground
set -g @thm_cyan      "#70c0b1"   # Aqua
set -g @thm_gray      "#969896"   # Comment
set -g @thm_magenta   "#c397d8"   # Purple
set -g @thm_red       "#d54e53"   # Red
set -g @thm_green     "#b9ca4a"   # Green
set -g @thm_yellow    "#e7c547"   # Yellow
set -g @thm_blue      "#7aa6da"   # Blue
set -g @thm_orange    "#e78c45"   # Orange
set -g @thm_hl_med    "#151515"   # between Background and Current Line

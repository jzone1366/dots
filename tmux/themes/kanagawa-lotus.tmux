# Kanagawa Lotus palette. Colors only; themes/layout.tmux uses them.
# WARNING: hex colors can't contain capital letters

set -g @thm_bg        "#f2ecbc"   # LotusWhite3
set -g @thm_bg_gutter "#e7dba0"   # LotusWhite4
set -g @thm_fg        "#545464"   # LotusInk1
set -g @thm_cyan      "#597b75"   # LotusAqua
set -g @thm_gray      "#8a8980"   # LotusGray3
set -g @thm_magenta   "#b35b79"   # LotusPink
set -g @thm_red       "#c84053"   # LotusRed
set -g @thm_green     "#6f894e"   # LotusGreen
set -g @thm_yellow    "#77713f"   # LotusYellow
set -g @thm_blue      "#9fb5c9"   # LotusBlue3
set -g @thm_orange    "#cc6d00"   # LotusOrange
set -g @thm_hl_med    "#e5ddb0"   # LotusWhite2

# Pastel Paper palette. Colors only; themes/layout.tmux uses them.
# WARNING: hex colors can't contain capital letters

set -g @thm_bg        "#030203"   # bg
set -g @thm_bg_gutter "#141414"   # bg gutter
set -g @thm_fg        "#fcf7f8"   # fg
set -g @thm_cyan      "#71b3d9"   # cyan
set -g @thm_gray      "#5c595c"   # gray
set -g @thm_magenta   "#f8a0b7"   # magenta
set -g @thm_red       "#bf3f50"   # red
set -g @thm_green     "#5cab7d"   # green
set -g @thm_yellow    "#fcd772"   # yellow
set -g @thm_blue      "#577fa1"   # blue
set -g @thm_orange    "#de8b61"   # orange
set -g @thm_hl_med    "#0c0b0c"   # between bg and gutter

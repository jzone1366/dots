# Gruvbox Dark palette. Colors only; themes/layout.tmux uses them.
# Upstream: https://github.com/morhetz/gruvbox
# WARNING: hex colors can't contain capital letters

set -g @thm_bg        "#282828"   # bg0
set -g @thm_bg_gutter "#3c3836"   # bg1
set -g @thm_fg        "#ebdbb2"   # fg1
set -g @thm_cyan      "#8ec07c"   # aqua
set -g @thm_gray      "#a89984"   # gray (fg4)
set -g @thm_magenta   "#d3869b"   # purple
set -g @thm_red       "#fb4934"   # red
set -g @thm_green     "#b8bb26"   # green
set -g @thm_yellow    "#fabd2f"   # yellow
set -g @thm_blue      "#83a598"   # blue
set -g @thm_orange    "#fe8019"   # orange
set -g @thm_hl_med    "#32302f"   # bg0_s

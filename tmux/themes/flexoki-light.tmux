# Flexoki Light palette. Colors only; themes/layout.tmux uses them.
# Upstream: https://stephango.com/flexoki (light uses the 600 accents)
# WARNING: hex colors can't contain capital letters

set -g @thm_bg        "#fffcf0"   # paper
set -g @thm_bg_gutter "#e6e4d9"   # base-100 (ui)
set -g @thm_fg        "#100f0f"   # black (tx)
set -g @thm_cyan      "#24837b"   # cyan-600
set -g @thm_gray      "#6f6e69"   # base-600 (tx-2)
set -g @thm_magenta   "#a02f6f"   # magenta-600
set -g @thm_red       "#af3029"   # red-600
set -g @thm_green     "#66800b"   # green-600
set -g @thm_yellow    "#ad8301"   # yellow-600
set -g @thm_blue      "#205ea6"   # blue-600
set -g @thm_orange    "#bc5215"   # orange-600
set -g @thm_hl_med    "#f2f0e5"   # base-50 (bg-2)
